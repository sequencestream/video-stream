# Build output
/bin/
/dist/
*.exe

# WebUI export embedded by internal/webui. Generated by `make webui-build`;
# only the .gitkeep is tracked, which is all //go:embed needs to compile.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Local runtime data
/data/
/output/
*.db
*.db-shm
*.db-wal

# Config with secrets
config.local.yaml
.env
.env.local

# Node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/
.codebuddy/
